export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"

export TERM=xterm-256color

export EDITOR="vim"
export VISUAL="vim"

#Credit: Mischa Burg
path=(
  $path
  $HOME/bin
  $HOME/.local/bin
  $XDG_CONFIG_HOME
  $XDG_DATA_HOME
  $XDG_CACHE_HOME
  $XDG_STATE_HOME
  )

typset -U path
path=($^path(N-/))

export PATH



