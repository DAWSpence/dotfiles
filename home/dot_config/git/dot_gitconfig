[init]
  defaultBranch = main

[user]
  name = DAWSpence
  email = ducspencer@gmail.com

[github]
  user = DAWSpence

[core]
  pager = delta --dark

[delta]

  navigate = true   
  light = false      

[commit]
  template = ~/.gitcommit

[alias]

  quick="git add -A -v && git commit -a --allow-empty-message -m '' && git push -u -v origin main"

  edit-unmerged = "!f() { git ls-files --unmerged | cut -f2 | sort -u ; }; vim `f`"

  add-unmerged = "!f() { git ls-files --unmerged | cut -f2 | sort -u ; }; git add `f`"

  co = checkout

  ci = commit

  ca = commit -a

  st = status

  br = branch

  ba = branch -a

  bm = branch --merged

  bn = branch --no-merged

  type = cat-file -t

  dump = cat-file -p
